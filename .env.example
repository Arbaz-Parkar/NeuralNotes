# Copy this file to .env to override local development settings.
NEURALNOTES_APP_NAME=NeuralNotes
NEURALNOTES_ENVIRONMENT=development
NEURALNOTES_LOG_LEVEL=INFO

# Local PostgreSQL settings for Docker Compose and the application.
# Update the URL credentials if the POSTGRES values change.
POSTGRES_DB=neuralnotes
POSTGRES_USER=neuralnotes
POSTGRES_PASSWORD=neuralnotes-local
NEURALNOTES_DATABASE_URL=postgresql+psycopg://neuralnotes:neuralnotes-local@127.0.0.1:5432/neuralnotes
